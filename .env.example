# PostgreSQL connection string. Create the database before running migrations.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/tenderwise

# NVIDIA NIM (OpenAI-compatible) model provider.
# Leave the API key blank if you only want to test health endpoints and non-AI features.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Advanced RAG controls. Semantic retrieval requires pgvector and NVIDIA_API_KEY.
# Keep reranking disabled initially; enable after validating latency and quality.
TENDERWISE_SEMANTIC_RETRIEVAL_ENABLED=true
TENDERWISE_RERANKER_ENABLED=false
TENDERWISE_RERANKER_MODEL=nvidia/nemotron-3.5-rerank-8b
TENDERWISE_RERANKER_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
TENDERWISE_CHUNK_TARGET_TOKENS=600
TENDERWISE_CHUNK_OVERLAP_TOKENS=80
TENDERWISE_QA_HISTORY_MESSAGES=8
TENDERWISE_QA_MAX_VECTOR_BACKFILL_PER_QUERY=256
TENDERWISE_QA_CANDIDATE_K=50
TENDERWISE_QA_RRF_K=60
TENDERWISE_QA_HNSW_EF_SEARCH=100
